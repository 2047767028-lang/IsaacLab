# CloudXR profile pinning the runtime to physical GPU1
# (nvidia-smi index 1, UUID 25ee1e79-..., PCI 38:00.0).
#
# VK_ICD_FILENAMES restricts the Vulkan loader to a single NVIDIA ICD. Without
# it this box loads /etc/vulkan/icd.d/nvidia_icd.json AND
# /usr/share/vulkan/icd.d/nvidia_icd.json, so every GPU is enumerated twice
# (9 devices incl. llvmpipe) -- Isaac Sim warns this causes instability/crashes.
# With the single ICD the list is exactly 4 devices:
#   vulkan 0 -> nvidia-smi 2 | vulkan 1 -> nvidia-smi 0
#   vulkan 2 -> nvidia-smi 1 | vulkan 3 -> nvidia-smi 3
# Only ONE of NV_CXR_GPU_INDEX_VULKAN / _CUDA may be set; the runtime derives
# the matching CUDA device from the Vulkan one.
VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json
NV_DEVICE_PROFILE=auto-webrtc
NV_CXR_ENABLE_PUSH_DEVICES=0
NV_ENABLE_POSE_WAIT=0
NV_CXR_GPU_INDEX_VULKAN=2
